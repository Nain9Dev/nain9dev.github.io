    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "7.3.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.3"
  }
