{
  "name": "astro-migration",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:source": "astro build",
    "build": "astro build && node scripts/build-locales.mjs",
    "preview": "astro preview",
    "check": "node --test scripts/localization.test.mjs scripts/localization-build.test.mjs && astro check && npm run build && npm run check:brand-icons && npm run check:seo && npm run check:locales",
    "check:locales": "node scripts/check-locales.mjs",
    "translations:prepare": "npm run build:source && node scripts/sync-translations.mjs",
    "translations:generate": "node scripts/watch-translations.mjs --once",
    "translations:watch": "node scripts/watch-translations.mjs",
    "translations:review": "node scripts/review-translations.mjs",
    "translations:preview": "npm run build:source && node scripts/build-locales.mjs --preview",
    "translations:serve": "astro preview --outDir .astro/localized-preview --host 127.0.0.1",
    "check:brand-icons": "node scripts/check-brand-icons.mjs",
    "check:seo": "node --test scripts/seo.test.mjs && node scripts/check-seo.mjs",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "7.3.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.3"
  }
}
