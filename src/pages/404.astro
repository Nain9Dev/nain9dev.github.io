---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalSection from '../components/home/TerminalSection.astro';

const title = "Página no encontrada | NainDev";
const description = "Lo sentimos, la página que buscas no existe. Explora la terminal o vuelve al inicio.";
---

<BaseLayout title={title} description={description} robots="noindex, follow">
  <main class="shell section" id="main-content" tabindex="-1">
    <div class="section-heading page-intro" data-reveal>
      <p class="eyebrow">Error 404</p>
      <h1>Parece que esta ruta <span class="title-accent">no existe.</span></h1>
      <p>
        El servidor no pudo encontrar el recurso solicitado. Puedes usar la terminal para explorar el sistema o visitar los enlaces rápidos.
      </p>
      <div class="button-group center-actions">
        <a class="button button-primary" href="/recursos/checklist-ia">Descargar Checklist IA</a>
        <a class="button button-secondary" href="/servicios">Ver Servicios</a>
        <a class="button button-outline" href="/blog">Leer Blog</a>
      </div>
    </div>

    <div class="terminal-wrap">
      <TerminalSection />
    </div>
  </main>
</BaseLayout>
