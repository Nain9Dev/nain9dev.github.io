---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TerminalSection from '../components/home/TerminalSection.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import TechStack from '../components/home/TechStack.astro';
import CaseStudiesSection from '../components/home/CaseStudiesSection.astro';
import ImpactMetrics from '../components/home/ImpactMetrics.astro';
// import Testimonials from '../components/home/Testimonials.astro'; // TODO: Activar cuando se tengan testimonios reales
import ProjectsSection from '../components/home/ProjectsSection.astro';
import MethodSection from '../components/home/MethodSection.astro';
import AboutSection from '../components/home/AboutSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
---

<BaseLayout
  title="Aitor Nain Mendoza Vallejo | Arquitecto Backend 3D"
  description="Aitor Nain Mendoza Vallejo, también conocido como NainDev, diseña arquitectura backend para validación 3D, IA generativa y sistemas críticos .NET."
  keywords={["Aitor Nain Mendoza Vallejo", "Aitor Nain", "Aitor Mendoza", "NainDev", "arquitecto backend 3D", "arquitectura IA"]}>
  <main id="main-content">
    <Hero />
    <TerminalSection />
    <ProofStrip />
    <ServicesSection />
    <TechStack />
    <CaseStudiesSection />
    <ImpactMetrics />
    <!-- <Testimonials /> (Oculto temporalmente por ética: reactivar al obtener clientes reales) -->
    <ProjectsSection />
    <MethodSection />
    <AboutSection />
    <ContactSection />
  </main>
</BaseLayout>
