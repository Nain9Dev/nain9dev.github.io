---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Checklist de Arquitectura de IA | NainDev";
const description = "Asegura que tu sistema de IA cumpla con los estándares de calidad, escalabilidad y seguridad. Descarga esta guía práctica y evalúa tu arquitectura en 10 pasos.";
---

<BaseLayout title={title} description={description}>
  <main class="shell section" id="main-content">
    <div class="case-study-card" style="box-shadow: none; border: none; background: transparent; padding: 0; max-width: 800px; margin: 0 auto;">
      <div class="section-heading" data-reveal style="text-align: center;">
        <p class="eyebrow">Lead Magnet Técnico</p>
        <h1 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Descubre los 10 Puntos Ciegos que Hacen Fracasar a los Sistemas de IA</h1>
        <p style="font-size: 1.1rem; color: var(--color-text-muted);">Evita sobrecostes masivos, caídas en producción y modelos que alucinan. Descarga el <strong>Checklist Definitivo de Arquitectura IA</strong> y blinda tu plataforma B2B hoy mismo.</p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 3rem;" class="checklist-layout">
        
        <!-- Beneficios -->
        <div data-reveal>
          <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">¿Qué vas a descubrir?</h2>
          <ul class="case-study-list" style="margin-left: 0; list-style: none;">
            <li style="margin-bottom: 1rem; position: relative; padding-left: 1.5rem;">
              <span style="position: absolute; left: 0; color: var(--color-primary);">✓</span>
              Cómo aislar los LLMs de tu lógica de negocio (Clean Architecture).
            </li>
            <li style="margin-bottom: 1rem; position: relative; padding-left: 1.5rem;">
              <span style="position: absolute; left: 0; color: var(--color-primary);">✓</span>
              Patrones para manejar la estocasticidad y <em>timeouts</em> sin que el servidor caiga.
            </li>
            <li style="margin-bottom: 1rem; position: relative; padding-left: 1.5rem;">
              <span style="position: absolute; left: 0; color: var(--color-primary);">✓</span>
              Estrategias FinOps: Técnicas de caché semántica para reducir la factura de API hasta un 80%.
            </li>
            <li style="margin-bottom: 1rem; position: relative; padding-left: 1.5rem;">
              <span style="position: absolute; left: 0; color: var(--color-primary);">✓</span>
              Seguridad Zero-Trust: Protección contra Prompt Injection y filtrado de PII.
            </li>
          </ul>
          
          <blockquote style="border-left: 3px solid var(--color-primary); padding-left: 1.5rem; margin-top: 2rem; font-style: italic; color: var(--color-text-muted);">
            "Aplicar el paso 3 de este checklist redujo nuestra factura de OpenAI a la mitad y estabilizó nuestra API en picos de tráfico."
            <br/><br/>
            <span style="font-size: 0.9rem; color: #fff;">— CT0 de una Startup SaaS B2B</span>
          </blockquote>
        </div>

        <!-- Formulario MailerLite -->
        <div class="form-container" data-reveal style="background: var(--color-surface); padding: 2rem; border-radius: 12px; border: 1px solid var(--color-line);">
          <h3 style="margin-top: 0; margin-bottom: 1.5rem; font-size: 1.3rem;">Únete a +200 Arquitectos que ya lo usan</h3>
          
          <!-- INICIO CÓDIGO MAILERLITE -->
          <!-- Pega aquí el código HTML/JS que te proporciona MailerLite al crear el formulario embebido -->
          <div id="mlb2-XXXXXXX" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-XXXXXXX">
            <div class="ml-form-align-center">
              <div class="ml-form-embedWrapper embedForm">
                <div class="ml-form-embedBody ml-form-embedBodyDefault row-form">
                  <div class="ml-form-embedContent" style="margin-bottom: 1.5rem;">
                    <p style="color: var(--color-text-muted);">Ingresa tu correo profesional (solo 1 paso) y recibe el PDF en tu bandeja de entrada inmediatamente.</p>
                  </div>
                  <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/xxx/forms/xxx/subscribe" data-code="xxxx" method="post" data-plausible-form="Lead_Magnet_Download">
                    <!-- Campos UTM ocultos para MailerLite -->
                    <input type="hidden" name="fields[utm_source]" value="checklist">
                    <input type="hidden" name="fields[utm_medium]" value="website">
                    <input type="hidden" name="fields[utm_campaign]" value="lead-magnet">
                    <input type="hidden" name="fields[utm_content]" id="utm-content-field" value="">
                    <!-- Los campos del formulario de MailerLite -->
                    <div class="ml-form-fieldRow ml-last-item">
                      <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required">
                        <input type="email" class="form-control" name="fields[email]" placeholder="tu@correo-profesional.com" autocomplete="email" required style="width: 100%; padding: 0.75rem; margin-bottom: 1rem; border-radius: 4px; border: 1px solid var(--color-line); background: rgba(0,0,0,0.2); color: white;" />
                      </div>
                    </div>
                    <button type="submit" class="primary" style="width: 100%; padding: 0.75rem; background: var(--color-primary); color: #000; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; transition: opacity 0.2s;">
                      Descargar Checklist
                    </button>
                    <div class="form-feedback" style="display: none; margin-top: 1rem; font-size: 0.9rem; text-align: center; padding: 0.5rem; border-radius: 4px;"></div>
                  </form>
                </div>
              </div>
            </div>
          </div>
          <!-- FIN CÓDIGO MAILERLITE -->

          <noscript>
            <div style="margin-top: 1.5rem; text-align: center; padding: 1rem; border-radius: 8px; border: 1px dashed var(--color-primary); background: rgba(0,0,0,0.2);">
              <p style="margin-bottom: 0.5rem; font-size: 0.95rem;">¿No ves el formulario?</p>
              <a href="mailto:contact@naindev.com?subject=Solicitud%20Checklist%20IA" style="color: var(--color-primary); font-weight: bold; text-decoration: underline;">Haz clic aquí para descargar el checklist por correo</a>
            </div>
          </noscript>
          
          <div id="mailerlite-fallback" style="display: none; margin-top: 1.5rem; text-align: center; padding: 1rem; border-radius: 8px; border: 1px dashed var(--color-primary); background: rgba(0,0,0,0.2);">
            <p style="margin-bottom: 0.5rem; font-size: 0.95rem;">¿El formulario no carga correctamente?</p>
            <a href="mailto:contact@naindev.com?subject=Solicitud%20Checklist%20IA" style="color: var(--color-primary); font-weight: bold; text-decoration: underline;">Haz clic aquí para solicitar el checklist por correo</a>
          </div>

          <p style="margin-top: 1.5rem; font-size: 0.8rem; color: var(--color-text-muted); text-align: center;">
            Al enviar, aceptas nuestra <a href="/privacidad" style="color: var(--color-primary);">Política de Privacidad</a>. Prometo no enviar spam.
          </p>
        </div>

      </div>
    </div>
  </main>

  <style>
    @media (max-width: 768px) {
      .checklist-layout {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <script>
    import '../../scripts/checklist-form.js';
  </script>
</BaseLayout>
