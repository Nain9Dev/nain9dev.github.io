---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultSEO } from '../../utils/seo';
import '../../styles/inner.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.description} keywords={post.data.keywords} tags={post.data.tags} date={post.data.pubDate} image={post.data.ogImage}>
  <main id="main-content" tabindex="-1">
  <article class="shell section page-top article">
    <h1>{post.data.title}</h1>
    <p class="article-byline">
      Por <a href="/#about" rel="author">{defaultSEO.author}</a> ·
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
      </time>
    </p>
    <Content />
    
    <div class="share-buttons" data-reveal>
      <span class="share-label">Compartir este artículo:</span>
      <button class="button button-secondary button-small" onclick="shareOnLinkedIn()" aria-label="Compartir en LinkedIn">LinkedIn</button>
      <button class="button button-secondary button-small" onclick="shareOnTwitter()" aria-label="Compartir en Twitter">Twitter</button>
      <button class="button button-secondary button-small" onclick="shareViaWebShare()" aria-label="Compartir en otras apps">Compartir</button>
    </div>

    <script>
      import '../../scripts/blog-share.js';
    </script>
  </article>
  </main>
</BaseLayout>
