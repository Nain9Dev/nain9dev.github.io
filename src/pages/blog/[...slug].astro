---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultSEO } from '../../utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.description} keywords={post.data.keywords} tags={post.data.tags} date={post.data.pubDate} image={post.data.ogImage}>
  <main id="main-content">
  <article class="shell section" style="padding-top: 8rem;">
    <h1>{post.data.title}</h1>
    <p class="article-byline">
      Por <a href="/#about" rel="author">{defaultSEO.author}</a> ·
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
      </time>
    </p>
    <Content />
    
    <div class="share-buttons" data-reveal style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-line); display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <span style="color: var(--color-text-muted); font-weight: 600;">Compartir este artículo:</span>
      <button class="button button-secondary button-small" onclick="shareOnLinkedIn()" aria-label="Compartir en LinkedIn">LinkedIn</button>
      <button class="button button-secondary button-small" onclick="shareOnTwitter()" aria-label="Compartir en Twitter">Twitter</button>
      <button class="button button-secondary button-small" onclick="shareViaWebShare()" aria-label="Compartir en otras apps">Compartir</button>
    </div>

    <script is:inline type="module">
      import { message } from '/assets/js/locale.js';
      window.shareViaWebShare = function() {
        if (navigator.share) {
          navigator.share({
            title: document.title,
            text: message('shareDescription'),
            url: window.location.href
          }).catch(console.error);
        } else {
          navigator.clipboard.writeText(window.location.href)
            .then(() => alert(message('shareCopied'))).catch(console.error);
        }
      }
      window.shareOnLinkedIn = function() {
        window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(window.location.href)}`, '_blank');
      }
      window.shareOnTwitter = function() {
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(message('shareDescription'))}&url=${encodeURIComponent(window.location.href)}`, '_blank');
      }
    </script>
  </article>
  </main>
</BaseLayout>
