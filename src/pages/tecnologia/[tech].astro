---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTechnologyRouteParam } from '../../utils/technologyRoutes';
import Quiet from '../../components/home/Quiet.astro';
import techStackData from '../../../public/assets/data/tech-stack.json';
import '../../styles/inner.css';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios', ({ data }) => !data.draft);
  const techs = new Set<string>();
  
  servicios.forEach(s => {
    if (s.data.techStack) {
      s.data.techStack.forEach((t: string) => techs.add(t));
    }
  });

  return Array.from(techs).map(tech => ({
    params: { tech: getTechnologyRouteParam(tech) },
    props: { tech }
  }));
}

const { tech } = Astro.props;
const servicios = await getCollection('servicios', ({ data }) => data.techStack?.includes(tech) && !data.draft);

// The stack icon for this technology, by exact name or by the family it belongs to (".NET 8" shows the .NET mark).
const stackItems = techStackData.categories.flatMap((category) => category.items);
const icon = (stackItems.find((item) => item.name === tech) ?? stackItems.find((item) => tech.startsWith(item.name)))?.icon ?? null;

const title = `Proyectos y Servicios con ${tech} | NainDev`;
const description = `Descubre cómo utilizamos ${tech} en arquitecturas de backend escalables y sistemas críticos 3D.`;
---

<BaseLayout title={title} description={description} robots="noindex, follow">
  <main class="shell section" id="main-content" tabindex="-1">
    <div class="section-heading tech-head" data-reveal>
      <div>
        {icon && <img class="tech-icon tech-hero-icon" src={icon} alt="" width="64" height="64" decoding="async" />}
        <p class="eyebrow">Tecnología Especializada</p>
        <h1>Experiencia con <span class="title-accent">{tech}</span></h1>
      </div>
      <Quiet><p>Servicios relacionados con {tech}.</p></Quiet>
    </div>

    {servicios.length > 0 && (
      <section class="related-services" data-reveal>
        <h2 class="related-title">Servicios Relacionados</h2>
        <div class="tech-grid">
          {servicios.map(servicio => (
            <a href={`/servicios/${servicio.id}`} class="case-study-card tech-link-card">
              <h3>{servicio.data.title}</h3>
              <p>{servicio.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="page-cta">
      <a href="/" class="button button-outline">Volver a inicio</a>
    </div>
  </main>
</BaseLayout>
