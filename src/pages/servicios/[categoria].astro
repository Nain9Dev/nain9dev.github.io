---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios', ({ data }) => data.draft !== true);
  return servicios.map(servicio => ({
    params: { categoria: servicio.id },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const { Content } = await render(servicio);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": servicio.data.title,
  "description": servicio.data.description,
  "provider": {
    "@id": `${new URL('/', Astro.site || 'https://www.naindev.com').toString()}#person`
  },
  "serviceType": servicio.data.techStack || [],
  "url": new URL(Astro.url.pathname, Astro.site || 'https://www.naindev.com').toString()
};
---

<BaseLayout title={servicio.data.title} description={servicio.data.description} keywords={servicio.data.keywords}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <article class="shell section" style="padding-top: 8rem;">
    {servicio.data.renderTitle && <h1>{servicio.data.title}</h1>}
    <Content />
  </article>
</BaseLayout>
