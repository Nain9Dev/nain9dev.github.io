---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import PrivacyBanner from '../components/PrivacyBanner.astro';
import { defaultSEO } from '../utils/seo';
import runtimeMessages from '../i18n/runtime.json';
import interFont from '../assets/fonts/inter-var.woff2?url';
import outfitFont from '../assets/fonts/outfit-var.woff2?url';
import '../styles/main.css';
import '../styles/terminal.css';
import '../styles/locales.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  keywords?: string[];
  robots?: string;
}

const {
  title = defaultSEO.title,
  description = defaultSEO.description,
  image = defaultSEO.image,
  date,
  author,
  tags,
  keywords,
  robots = defaultSEO.robots
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.naindev.com');
---

<!doctype html>
<html lang="es-ES">
<head>
  <SEO title={title} description={description} image={image} canonicalURL={canonicalURL} date={date} author={author} tags={tags} keywords={keywords} robots={robots} />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="icon" type="image/x-icon" href="/favicon-naindev.ico">
  <link rel="icon" type="image/svg+xml" sizes="any" href="/assets/images/favicon-optimized.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={outfitFont} as="font" type="font/woff2" crossorigin>
  <script defer data-domain="naindev.com" src="https://plausible.io/js/script.js"></script>
  <script is:inline>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
  <title>{title}</title>
  <script is:inline id="localized-ui" type="application/json" set:html={JSON.stringify(runtimeMessages).replaceAll('<', '\\u003c')} />

    <!-- Cheap capability checks before first paint; the WebGL probe runs later from the deferred bundle (PERF-005). -->
    <script is:inline>
      document.documentElement.classList.add("motion-ready");
      try {
        const isLowPerformance = window.innerWidth < 768 ||
          (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) ||
          (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) ||
          (navigator.hardwareConcurrency && navigator.hardwareConcurrency < 4) ||
          (navigator.deviceMemory && navigator.deviceMemory < 4) ||
          (navigator.connection && navigator.connection.saveData);
        if (isLowPerformance) document.documentElement.classList.add("low-performance");
      } catch (e) {}
    </script>
    
    <!-- ClientRouter for ViewTransitions -->
    <ClientRouter />

  <slot name="head" />
</head>

<body id="top">
  <a class="skip-link" href="#main-content">Saltar al contenido principal</a>

  <Header />

  <slot />

  <Footer />
  <PrivacyBanner />

  <script>
    import '../scripts/app.js';
  </script>

  <script>
    import { initializeGlobalAnalytics, trackTerminalCommand } from "../utils/analytics.js";
    
    // Initialize global tracking (Calendly)
    initializeGlobalAnalytics();
    
    // Expose tracking helper for static terminal script
    window.trackTerminalCommand = trackTerminalCommand;
  </script>
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll('a[href^="mailto:"]:not([data-tracked])').forEach(link => {
        link.dataset.tracked = "true";
        link.addEventListener('click', () => window.plausible && window.plausible('Contacto', {props: { method: 'Email' }}));
      });
      document.querySelectorAll('a[href^="http"]:not([data-tracked])').forEach(link => {
        if (!link.href.includes('naindev.com') && !link.href.includes('calendly.com')) {
           link.dataset.tracked = "true";
           link.addEventListener('click', () => window.plausible && window.plausible('Outbound Link', {props: { url: link.href }}));
        }
      });
    });
  </script>
</body>
</html>
