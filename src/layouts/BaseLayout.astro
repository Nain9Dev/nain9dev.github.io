---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import PrivacyBanner from '../components/PrivacyBanner.astro';
import { defaultSEO } from '../utils/seo';
import runtimeMessages from '../i18n/runtime.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  keywords?: string[];
  robots?: string;
}

const {
  title = defaultSEO.title,
  description = defaultSEO.description,
  image = defaultSEO.image,
  date,
  author,
  tags,
  keywords,
  robots = defaultSEO.robots
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.naindev.com');
---

<!doctype html>
<html lang="es-ES">
<head>
  <SEO title={title} description={description} image={image} canonicalURL={canonicalURL} date={date} author={author} tags={tags} keywords={keywords} robots={robots} />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="icon" type="image/x-icon" href="/favicon-naindev.ico">
  <link rel="icon" type="image/svg+xml" sizes="any" href="/assets/images/favicon-optimized.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/outfit-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css?v=019">
  <link rel="stylesheet" href="/assets/css/terminal.css?v=019">
  <script defer data-domain="naindev.com" src="https://plausible.io/js/script.js"></script>
  <script is:inline>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
  <title>{title}</title>
  <script is:inline id="localized-ui" type="application/json" set:html={JSON.stringify(runtimeMessages).replaceAll('<', '\\u003c')} />

    <!-- Pre-procesar animaciones para evitar FOUC y detectar bajo rendimiento temprano -->
    <script is:inline>
      document.documentElement.classList.add("motion-ready");
      try {
        const isMobileOrTouch = window.innerWidth < 768 || (window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
        let isLowPerformance = isMobileOrTouch ||
          (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) ||
          (navigator.hardwareConcurrency && navigator.hardwareConcurrency < 4) ||
          (navigator.deviceMemory && navigator.deviceMemory < 4) ||
          (navigator.connection && navigator.connection.saveData);

        if (!isLowPerformance) {
          try {
            const canvas = document.createElement('canvas');
            const gl = canvas.getContext('webgl2', { failIfMajorPerformanceCaveat: true })
                    || canvas.getContext('webgl', { failIfMajorPerformanceCaveat: true });
            if (!gl) {
              isLowPerformance = true;
            } else {
              const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
              if (debugInfo) {
                const renderer = String(gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL) || '').toLowerCase();
                const sw = ['swiftshader', 'software', 'llvmpipe', 'softpipe', 'virtualbox', 'vmware', 'basic render', 'warp', 'mesa', 'cpu'];
                if (sw.some((k) => renderer.includes(k))) isLowPerformance = true;
              }
              const lose = gl.getExtension('WEBGL_lose_context');
              if (lose) lose.loseContext();
            }
          } catch (e) {
            isLowPerformance = true;
          }
        }

        if (isLowPerformance) {
          document.documentElement.classList.add("low-performance");
        } else {
          document.documentElement.classList.add("high-performance");
        }
      } catch (e) {}
    </script>
    
    <!-- ClientRouter for ViewTransitions -->
    <ClientRouter />

  <slot name="head" />
</head>

<body id="top">
  <a class="skip-link" href="#main-content">Saltar al contenido principal</a>

  <Header />

  <slot />

  <Footer />
  <PrivacyBanner />

  <script type="module" src="/assets/js/app.js?v=019"></script>

  <script>
    import { initializeGlobalAnalytics, trackTerminalCommand } from "../utils/analytics.js";
    
    // Initialize global tracking (Calendly)
    initializeGlobalAnalytics();
    
    // Expose tracking helper for static terminal script
    window.trackTerminalCommand = trackTerminalCommand;
  </script>
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll('a[href^="mailto:"]:not([data-tracked])').forEach(link => {
        link.dataset.tracked = "true";
        link.addEventListener('click', () => window.plausible && window.plausible('Contacto', {props: { method: 'Email' }}));
      });
      document.querySelectorAll('a[href^="http"]:not([data-tracked])').forEach(link => {
        if (!link.href.includes('naindev.com') && !link.href.includes('calendly.com')) {
           link.dataset.tracked = "true";
           link.addEventListener('click', () => window.plausible && window.plausible('Outbound Link', {props: { url: link.href }}));
        }
      });
    });
  </script>
</body>
</html>
