---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  keywords?: string[];
}

const {
  title = "Aitor Nain — Arquitecto Backend 3D & AI Systems | .NET",
  description = "Arquitecto Backend especializado en infraestructura para procesamiento 3D masivo, integración de IA Generativa, agentes de IA y sistemas críticos .NET.",
  image = "https://www.naindev.com/assets/images/og-cover-v2.png",
  date,
  author,
  tags,
  keywords
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.naindev.com');
---

<!doctype html>
<html lang="es">
<head>
  <SEO title={title} description={description} image={image} canonicalURL={canonicalURL} date={date} author={author} tags={tags} keywords={keywords} />
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon-optimized.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon-optimized.svg">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="stylesheet" href="/assets/css/terminal.css">
  <script defer data-domain="naindev.com" src="https://plausible.io/js/script.js"></script>
  <script is:inline>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
  <title>{title}</title>
  <meta name="theme-color" content="#030712" />

    <!-- Pre-procesar animaciones para evitar FOUC -->
    <script is:inline>
      document.documentElement.classList.add("motion-ready");
    </script>
    
    <!-- ClientRouter for ViewTransitions -->
    <ClientRouter />

  <slot name="head" />
</head>

<body id="top">
  <a class="skip-link" href="#main-content">Saltar al contenido principal</a>

  <Header />

  <slot />

  <Footer />

  <script type="module" src="/assets/js/app.js"></script>

  <script>
    import { initializeGlobalAnalytics, trackTerminalCommand } from "../utils/analytics.js";
    
    // Inicializar tracking global (Calendly)
    initializeGlobalAnalytics();
    
    // Exponer función para que terminal.js (estático) pueda usarla
    window.trackTerminalCommand = trackTerminalCommand;
  </script>
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll('a[href^="mailto:"]:not([data-tracked])').forEach(link => {
        link.dataset.tracked = "true";
        link.addEventListener('click', () => window.plausible && window.plausible('Contacto', {props: { method: 'Email' }}));
      });
      document.querySelectorAll('a[href^="http"]:not([data-tracked])').forEach(link => {
        if (!link.href.includes('naindev.com') && !link.href.includes('calendly.com')) {
           link.dataset.tracked = "true";
           link.addEventListener('click', () => window.plausible && window.plausible('Outbound Link', {props: { url: link.href }}));
        }
      });
    });
  </script>
</body>
</html>
