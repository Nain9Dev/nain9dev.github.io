---
// QuoteSimulator.astro
// Interactive project scope and investment simulator based on NainDev Clean Architecture delivery standards.
---

<section class="section section-simulator" id="simulador-presupuestos">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">Herramienta Interactiva</p>
        <h2>Simulador de Alcance y Propuesta Técnica</h2>
      </div>
      <p>Estima el plazo y alcance de tu proyecto bajo estándares de Clean Architecture, tests deterministas y coste de infraestructura cero.</p>
    </div>

    <div class="simulator-card glass-panel" data-reveal id="quote-simulator">
      <div class="simulator-grid">
        <!-- Controls Column -->
        <div class="simulator-form">
          <div class="control-group">
            <label class="control-label" for="sim-pillar">Pilar de Especialización</label>
            <select id="sim-pillar" class="select-input">
              <option value="3d-cad" selected>Validación 3D y Motores CAD Paramétricos (OpenCASCADE / Three.js)</option>
              <option value="dotnet-enterprise">Backend Enterprise y Modernización .NET (.NET 10 / Clean Architecture)</option>
              <option value="deterministic-ai">IA Determinista y Automatización B2B (Pipelines sin alucinaciones)</option>
            </select>
          </div>

          <div class="control-group">
            <label class="control-label" for="sim-scope">Nivel de Alcance Requerido</label>
            <select id="sim-scope" class="select-input">
              <option value="audit">Auditoría Técnica, Diagnóstico y Especificación Formal (EARS / ADRs)</option>
              <option value="poc" selected>Prototipo Funcional Verificable (PoC con Batería de Pruebas)</option>
              <option value="turnkey">Solución Completa de Producción (Clean Architecture, CI/CD, 100% Tests)</option>
            </select>
          </div>

          <div class="control-group">
            <label class="control-label" for="sim-volume">Volumen Estimado (Modelos 3D / Endpoints / Fuentes de Datos)</label>
            <div class="slider-container">
              <input type="range" id="sim-volume" min="1" max="25" value="5" step="1" class="range-slider" />
              <span class="slider-badge" id="sim-volume-val">5 unidades</span>
            </div>
          </div>

          <div class="control-group">
            <label class="control-label">Requisitos Específicos</label>
            <div class="checkbox-grid">
              <label class="check-item">
                <input type="checkbox" id="check-high-throughput" checked />
                <span>Presupuesto estricto de latencia (&lt;50ms)</span>
              </label>
              <label class="check-item">
                <input type="checkbox" id="check-property-tests" checked />
                <span>Testing basado en propiedades (Hypothesis/xUnit)</span>
              </label>
              <label class="check-item">
                <input type="checkbox" id="check-zero-cost-ci" checked />
                <span>CI/CD automatizado con 0 € de coste recurrente</span>
              </label>
              <label class="check-item">
                <input type="checkbox" id="check-human-review" />
                <span>Escalado a supervisión humana garantizado</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Output Column -->
        <div class="simulator-summary">
          <div class="summary-header">
            <span class="summary-tag">Estimación Orientativa</span>
            <div class="estimate-timeline">
              <span class="timeline-number" id="est-weeks">3 - 4</span>
              <span class="timeline-label">semanas de desarrollo</span>
            </div>
          </div>

          <div class="deliverables-box">
            <p class="deliverables-title">Entregables Clave Incluidos:</p>
            <ul class="deliverables-list" id="deliverables-list">
              <li>Código fuente completo en inglés técnico bajo Clean Architecture</li>
              <li>Batería de pruebas automatizadas con cobertura total de requisitos</li>
              <li>Pipeline CI/CD en GitHub Actions y contenedores Docker reproducibles</li>
              <li>Documentación viva numerada por fases (requisitos EARS y ADRs)</li>
              <li>Acompañamiento en puesta en marcha y garantía técnica</li>
            </ul>
          </div>

          <div class="summary-cta">
            <a href="https://calendly.com/aitornainmendozavallejo-ksez/30min" target="_blank" rel="noopener noreferrer" class="button button-primary button-full" id="sim-cta-link">
              Solicitar Propuesta Técnica Formal
            </a>
            <p class="summary-disclaimer">
              Estimación basada en metodologías ágiles de ingeniería. El presupuesto definitivo se formaliza sin compromiso tras llamada de evaluación técnica.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(() => {
  const pillarSelect = document.getElementById('sim-pillar');
  const scopeSelect = document.getElementById('sim-scope');
  const volumeSlider = document.getElementById('sim-volume');
  const volumeVal = document.getElementById('sim-volume-val');
  const weeksDisplay = document.getElementById('est-weeks');
  const deliverablesList = document.getElementById('deliverables-list');
  const ctaLink = document.getElementById('sim-cta-link');

  if (!pillarSelect || !scopeSelect || !volumeSlider || !weeksDisplay) return;

  function recalculate() {
    const pillar = pillarSelect.value;
    const scope = scopeSelect.value;
    const volume = parseInt(volumeSlider.value, 10);
    volumeVal.textContent = volume + (volume === 1 ? ' unidad' : ' unidades');

    let baseWeeksMin = 1;
    let baseWeeksMax = 2;

    if (scope === 'audit') {
      baseWeeksMin = 1;
      baseWeeksMax = 2;
    } else if (scope === 'poc') {
      baseWeeksMin = 2 + Math.floor(volume / 8);
      baseWeeksMax = 4 + Math.floor(volume / 6);
    } else {
      baseWeeksMin = 4 + Math.floor(volume / 5);
      baseWeeksMax = 8 + Math.floor(volume / 4);
    }

    weeksDisplay.textContent = baseWeeksMin + ' - ' + baseWeeksMax;

    // Update deliverables dynamically
    let items = [
      'Código fuente completo en inglés técnico bajo Clean Architecture',
      'Batería de pruebas automatizadas con cobertura total de requisitos',
      'Pipeline CI/CD en GitHub Actions y contenedores Docker reproducibles',
      'Documentación técnica formal (requisitos EARS y ADRs)'
    ];

    if (pillar === '3d-cad') {
      items.unshift('Motor generativo B-Rep en OpenCASCADE y validación topológica C1–C10');
      items.push('Visor WebGL en Three.js con planos de corte y metrología 3D');
    } else if (pillar === 'dotnet-enterprise') {
      items.unshift('Backend enterprise en .NET 10 LTS con minimal APIs y CQRS');
      items.push('Persistencia optimizada en SQL Server / PostgreSQL con EF Core y Dapper');
    } else {
      items.unshift('Pipeline de extracción y estructuración con LLMs y gates de dominio deterministas');
      items.push('Automatización autónoma programada con costes de ejecución de 0 €');
    }

    deliverablesList.innerHTML = items.map(it => '<li>' + it + '</li>').join('');

    // Pre-fill CTA link parameters
    const subject = encodeURIComponent('Evaluación Técnica: ' + pillar + ' (' + scope + ')');
    ctaLink.href = 'https://calendly.com/aitornainmendozavallejo-ksez/30min';
  }

  pillarSelect.addEventListener('change', recalculate);
  scopeSelect.addEventListener('change', recalculate);
  volumeSlider.addEventListener('input', recalculate);
  recalculate();
})();
</script>

<style>
.section-simulator {
  padding: 5rem 0;
  background: var(--bg-surface-elevated, rgba(16, 18, 26, 0.4));
  border-top: 1px solid var(--color-border-subtle, rgba(255, 255, 255, 0.06));
  border-bottom: 1px solid var(--color-border-subtle, rgba(255, 255, 255, 0.06));
}

.simulator-card {
  background: rgba(16, 18, 26, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1rem;
  padding: 2.5rem;
  margin-top: 2rem;
  box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
}

.simulator-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
}

@media (min-width: 900px) {
  .simulator-grid {
    grid-template-columns: 1.2fr 1fr;
  }
}

.control-group {
  margin-bottom: 1.5rem;
}

.control-label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted, #94a3b8);
  margin-bottom: 0.5rem;
}

.select-input {
  width: 100%;
  padding: 0.75rem 1rem;
  background: rgba(9, 10, 15, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 0.5rem;
  color: #fff;
  font-size: 0.875rem;
  font-family: inherit;
  outline: none;
}

.select-input:focus {
  border-color: var(--color-accent, #6366f1);
}

.slider-container {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.range-slider {
  flex: 1;
  height: 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.1);
  accent-color: var(--color-accent, #6366f1);
  cursor: pointer;
}

.slider-badge {
  font-family: var(--font-mono, monospace);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-accent-cyan, #38bdf8);
  background: rgba(56, 189, 248, 0.1);
  padding: 0.25rem 0.6rem;
  border-radius: 0.25rem;
  white-space: nowrap;
}

.checkbox-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.6rem;
  margin-top: 0.5rem;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.8125rem;
  color: var(--color-text-muted, #cbd5e1);
  cursor: pointer;
}

.check-item input[type="checkbox"] {
  accent-color: var(--color-accent, #6366f1);
  width: 1rem;
  height: 1rem;
}

.simulator-summary {
  background: rgba(9, 10, 15, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 0.75rem;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.summary-header {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 1.25rem;
  margin-bottom: 1.25rem;
}

.summary-tag {
  display: inline-block;
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-accent-emerald, #10b981);
  margin-bottom: 0.5rem;
}

.estimate-timeline {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
}

.timeline-number {
  font-size: 2.25rem;
  font-weight: 800;
  font-family: var(--font-mono, monospace);
  color: #fff;
  line-height: 1;
}

.timeline-label {
  font-size: 0.875rem;
  color: var(--color-text-muted, #94a3b8);
}

.deliverables-box {
  margin-bottom: 1.5rem;
}

.deliverables-title {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted, #94a3b8);
  margin-bottom: 0.75rem;
  font-weight: 600;
}

.deliverables-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.deliverables-list li {
  font-size: 0.8125rem;
  line-height: 1.5;
  color: #e2e8f0;
  position: relative;
  padding-left: 1.25rem;
}

.deliverables-list li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: var(--color-accent-emerald, #10b981);
  font-weight: 700;
}

.button-full {
  width: 100%;
  text-align: center;
  padding: 0.875rem 1.5rem;
}

.summary-disclaimer {
  font-size: 0.6875rem;
  color: var(--color-text-dim, #64748b);
  margin-top: 0.75rem;
  line-height: 1.4;
  text-align: center;
}
</style>
