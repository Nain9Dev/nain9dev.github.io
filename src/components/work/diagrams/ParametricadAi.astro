{/* ParametriCAD AI: from the web form or prompt to a validated export. Source: docs/assets/diagrams/work-parametricad-ai.mmd */}
<svg viewBox="0 0 720 320" role="img" aria-labelledby="pc-title pc-desc" data-translate="yes" xmlns="http://www.w3.org/2000/svg">
  <title id="pc-title">Arquitectura de ParametriCAD AI</title>
  <desc id="pc-desc">La interfaz web envía un formulario o una frase a la API. La extracción de parámetros, con reglas o con un modelo de lenguaje opcional, alimenta el motor paramétrico. La validación topológica decide si el sólido se exporta a GLB, STL, STEP o DXF y vuelve a la interfaz.</desc>
  <defs>
    <marker id="pc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="arrow" /></marker>
    <marker id="pc-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="arrow arrow-accent" /></marker>
  </defs>
  <rect class="node" x="20" y="40" width="200" height="64" rx="8" />
  <text class="label" x="120" y="66" text-anchor="middle">Interfaz web</text>
  <text class="label-soft" x="120" y="88" text-anchor="middle">React · Three.js</text>
  <rect class="node" x="260" y="40" width="200" height="64" rx="8" />
  <text class="label" x="360" y="66" text-anchor="middle">API</text>
  <text class="label-soft" x="360" y="88" text-anchor="middle">FastAPI · Pydantic</text>
  <rect class="node" x="500" y="40" width="200" height="64" rx="8" />
  <text class="label" x="600" y="66" text-anchor="middle">Extracción de parámetros</text>
  <text class="label-soft" x="600" y="88" text-anchor="middle">reglas o modelo de lenguaje</text>
  <rect class="node" x="500" y="216" width="200" height="64" rx="8" />
  <text class="label" x="600" y="242" text-anchor="middle">Motor paramétrico</text>
  <text class="label-soft" x="600" y="264" text-anchor="middle">CadQuery · OpenCASCADE</text>
  <rect class="node node-accent" x="260" y="216" width="200" height="64" rx="8" />
  <text class="label" x="360" y="242" text-anchor="middle">Validación topológica</text>
  <text class="label-soft" x="360" y="264" text-anchor="middle">sólido estanco y 2-variedad</text>
  <rect class="node" x="20" y="216" width="200" height="64" rx="8" />
  <text class="label" x="120" y="242" text-anchor="middle">Exportación</text>
  <text class="label-soft" x="120" y="264" text-anchor="middle">GLB · STL · STEP · DXF</text>
  <path class="flow" d="M220 72H258" marker-end="url(#pc-arrow)" />
  <path class="flow" d="M460 72H498" marker-end="url(#pc-arrow)" />
  <path class="flow" d="M600 104V214" marker-end="url(#pc-arrow)" />
  <path class="flow" d="M500 248H462" marker-end="url(#pc-arrow)" />
  <path class="flow flow-accent" d="M260 248H222" marker-end="url(#pc-arrow-accent)" />
  <path class="flow" d="M120 216V106" marker-end="url(#pc-arrow)" stroke-dasharray="4 4" />
  <text class="label-soft" x="132" y="166">respuesta</text>
</svg>
