---
// ServiceIcon.astro: decorative glyph for a service, from the `icon` field of its frontmatter (spec 047).
// Unknown or emoji values fall back to a named glyph so every service renders one.
interface Props {
  name?: string;
  class?: string;
}

const SHAPES: Record<string, string> = {
  cube: '<path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3ZM12 12 4 7.5M12 12l8-4.5M12 12v9" />',
  shield: '<path d="M12 3 4 6.5v5.5c0 4.5 3.3 7.8 8 9 4.7-1.2 8-4.5 8-9V6.5L12 3Z" /><path d="m8.5 12 2.5 2.5 4.5-5" />',
  server: '<rect x="3" y="4" width="18" height="7" rx="2" /><rect x="3" y="13" width="18" height="7" rx="2" /><path d="M7 7.5h.01M7 16.5h.01" />',
  brain: '<path d="M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-2 3 3 3 0 0 0 2 3v1a3 3 0 0 0 3 3h3V4H9Z" /><path d="M15 4a3 3 0 0 1 3 3v1a3 3 0 0 1 2 3 3 3 0 0 1-2 3v1a3 3 0 0 1-3 3h-3V4h3Z" />',
  cpu: '<rect x="6" y="6" width="12" height="12" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />',
  zap: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />',
  'check-circle': '<circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" />',
};
const ALIASES: Record<string, string> = { '⚡': 'zap', '🏗️': 'server', '🧊': 'cube' };

const { name, class: className = '' } = Astro.props;
const key = (name && (SHAPES[name] ? name : ALIASES[name])) || 'cube';
---
<svg class={`service-glyph ${className}`.trim()} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={SHAPES[key]} />
