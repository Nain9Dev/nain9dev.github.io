---
import { defaultSEO, getBreadcrumbItems, serializeJsonLd } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  keywords?: string[];
  canonicalURL?: URL;
  robots?: string;
}

const {
  title = defaultSEO.title,
  description = defaultSEO.description,
  image = defaultSEO.image,
  date,
  author = defaultSEO.author,
  tags = [],
  keywords = [],
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.naindev.com'),
  robots = defaultSEO.robots
} = Astro.props;

const isArticle = !!date;
const isHome = Astro.url.pathname === '/';
const siteURL = new URL('/', Astro.site || 'https://www.naindev.com').toString();
const personId = `${siteURL}#person`;
const organizationId = `${siteURL}#organization`;
const websiteId = `${siteURL}#website`;
const contrast3dId = 'https://www.contrast3d.com/#organization';
const webpageId = `${canonicalURL.toString()}#webpage`;
const articleId = `${canonicalURL.toString()}#article`;

const absoluteImageUrl = new URL(image, siteURL).toString();
const isDefaultImage = absoluteImageUrl === new URL(defaultSEO.image, siteURL).toString();
const imageAlt = isDefaultImage ? defaultSEO.imageAlt : title;

const personSchema = {
  "@type": "Person",
  "@id": personId,
  "name": "Aitor Nain Mendoza Vallejo",
  "alternateName": ["NainDev", "Aitor Nain", "Aitor Mendoza", "Aitor Mendoza Vallejo"],
  "url": siteURL,
  "jobTitle": "Arquitecto de Software Full Stack",
  "affiliation": { "@id": contrast3dId },
  "sameAs": [
    "https://github.com/Nain9Dev",
    "https://github.com/naindev-contrast3d",
    "https://www.linkedin.com/in/aitor-nain-mendoza-vallejo/",
    "https://gitlab.com/aitornainmendozavallejo",
    "https://x.com/Nain9Dev"
  ]
};

const organizationSchema = {
  "@type": "Organization",
  "@id": organizationId,
  "name": "NainDev",
  "url": siteURL,
  "logo": new URL('/apple-touch-icon.png', siteURL).toString(),
  "founder": { "@id": personId },
  "sameAs": [
    "https://www.linkedin.com/company/146215151/",
    "https://github.com/Nain9Dev",
    "https://gitlab.com/aitornainmendozavallejo",
    "https://x.com/Nain9Dev",
    "https://www.youtube.com/@Nain9Dev",
    "https://www.instagram.com/nainndev/",
    "https://www.tiktok.com/@nain9dev",
    "https://www.threads.com/@nainndev",
    "https://share.google/1tIQO3tlW8K8qVZ9R"
  ]
};

const contrast3dSchema = {
  "@type": "Organization",
  "@id": contrast3dId,
  "name": "Contrast3D",
  "url": "https://www.contrast3d.com/"
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  "url": siteURL,
  "name": defaultSEO.siteName,
  "alternateName": ["naindev.com", "Aitor Nain"],
  "inLanguage": "es",
  "publisher": { "@id": organizationId }
};

const articleSchema = isArticle ? {
  "@type": "BlogPosting",
  "@id": articleId,
  "url": canonicalURL.toString(),
  "headline": title,
  "description": description,
  "image": [absoluteImageUrl],
  "datePublished": date.toISOString(),
  "author": { "@id": personId },
  "publisher": { "@id": organizationId },
  "isPartOf": { "@id": websiteId },
  "mainEntityOfPage": { "@id": webpageId },
  "inLanguage": "es"
} : undefined;

const webpageSchema = {
  "@type": isHome ? "ProfilePage" : "WebPage",
  "@id": webpageId,
  "url": canonicalURL.toString(),
  "name": title,
  "description": description,
  "isPartOf": { "@id": websiteId },
  ...(isHome ? {
    "about": { "@id": personId },
    "mainEntity": { "@id": personId }
  } : {}),
  ...(isArticle ? { "mainEntity": { "@id": articleId } } : {}),
  "inLanguage": "es"
};

const breadcrumbs = getBreadcrumbItems(Astro.url.pathname, title);

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalURL.toString()}#breadcrumb`,
  "itemListElement": breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "item": new URL(b.item, siteURL).href
  }))
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    personSchema,
    organizationSchema,
    contrast3dSchema,
    websiteSchema,
    webpageSchema,
    ...(articleSchema ? [articleSchema] : []),
    ...(breadcrumbs.length > 1 ? [breadcrumbSchema] : [])
  ]
};
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<meta name="author" content={author}>
<meta name="theme-color" content="#090A0F">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta http-equiv="Content-Security-Policy"
  content="default-src 'self'; base-uri 'self'; connect-src 'self' https://plausible.io; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-src 'none'; img-src 'self' data: https:; object-src 'none'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests">
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')}>}

<meta property="og:type" content={isArticle ? "article" : "website"}>
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content={defaultSEO.siteName}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={absoluteImageUrl}>
{isDefaultImage && <meta property="og:image:width" content="1200">}
{isDefaultImage && <meta property="og:image:height" content="630">}
<meta property="og:image:alt" content={imageAlt}>
{date && <meta property="article:published_time" content={date.toISOString()}>}
{isArticle && <meta property="article:author" content={siteURL}>}
{isArticle && tags.map(tag => <meta property="article:tag" content={tag}>)}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@Nain9Dev">
<meta name="twitter:creator" content="@Nain9Dev">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={absoluteImageUrl}>
<meta name="twitter:image:alt" content={imageAlt}>

<link rel="canonical" href={canonicalURL}>
<link rel="sitemap" href="/sitemap-index.xml">

<!-- Schema.org JSON-LD -->
<script is:inline type="application/ld+json" set:html={serializeJsonLd(schema)} />
