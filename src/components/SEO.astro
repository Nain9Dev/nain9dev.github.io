---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  keywords?: string[];
  canonicalURL?: URL;
}

const {
  title = "Aitor Nain Mendoza Vallejo — Arquitecto Backend 3D & AI Systems | .NET",
  description = "Aitor Nain Mendoza Vallejo es Arquitecto Backend especializado en infraestructura para procesamiento 3D masivo, integración de IA Generativa, agentes de IA y sistemas críticos .NET.",
  image = "/assets/images/og-cover-v2.png",
  date,
  author = "Aitor Nain Mendoza Vallejo",
  tags = [],
  keywords = [],
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.naindev.com')
} = Astro.props;

const isArticle = !!date;

const formattedTitle = title.includes("Aitor Nain Mendoza Vallejo") 
  ? title 
  : `${title} | Aitor Nain Mendoza Vallejo`;

// Asegurar que la URL de la imagen sea siempre absoluta
const absoluteImageUrl = image.startsWith('http') 
  ? image 
  : new URL(image, Astro.site || 'https://www.naindev.com').toString();

const schema = isArticle ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": formattedTitle,
  "image": [absoluteImageUrl],
  "datePublished": date.toISOString(),
  "author": [{
    "@type": "Person",
    "name": author,
    "url": "https://www.naindev.com"
  }]
} : {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": formattedTitle,
  "description": description,
  "url": canonicalURL.toString()
};

const pathname = Astro.url.pathname;
const parts = pathname.split('/').filter(Boolean);
const breadcrumbs = [{ name: 'Inicio', item: '/' }];
let currentPath = '';
for (const part of parts) {
  currentPath += '/' + part;
  const name = part.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
  breadcrumbs.push({ name, item: currentPath });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    "item": new URL(b.item, Astro.site || 'https://www.naindev.com').href
  }))
};
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content={description}>
<meta name="robots" content="index, follow">
<meta name="author" content={author}>
<meta name="theme-color" content="#090A0F">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta http-equiv="Content-Security-Policy"
  content="default-src 'self'; base-uri 'self'; connect-src 'self' https://plausible.io https://assets.mailerlite.com https://*.mailerlite.com; font-src 'self' https://fonts.gstatic.com; form-action 'self' https://assets.mailerlite.com https://*.mailerlite.com; frame-src 'none'; img-src 'self' data: https:; object-src 'none'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://plausible.io https://assets.mailerlite.com https://*.mailerlite.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests">
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')}>}

<meta property="og:type" content={isArticle ? "article" : "website"}>
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content="Aitor Nain">
<meta property="og:title" content={formattedTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={absoluteImageUrl}>
<meta property="og:image:width" content="1731">
<meta property="og:image:height" content="909">
<meta property="og:image:alt" content="Representación visual de API, lógica de negocio y datos para NainDev">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@NainDev">
<meta name="twitter:creator" content="@NainDev">
<meta name="twitter:title" content={formattedTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={absoluteImageUrl}>

<link rel="canonical" href={canonicalURL}>

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
