---
// Header.astro
// The top bar has three links, each a stroke icon and one word (specs/next-design-fusion, DF-018); the other
// links live in the footer. The link of the section the visitor is in is marked as the current page.
const section = Astro.url.pathname.split('/').filter(Boolean)[0];
const current = ['servicios', 'proyectos', 'blog'].includes(section) ? section : undefined;
---

<header class="site-header" data-site-header>
  <div class="shell header-layout" data-nosnippet>
    <a class="brand" href="/#top" aria-label="NainDev, volver al inicio" title="Volver al inicio">
      <!-- Isotype from its three strokes (next-design-fusion DF-004): one colour, so it follows the theme. The strokes
           are separate paths so the mark can draw itself once, one stroke after another (DF-022). -->
      <svg class="brand-mark" viewBox="91 91 818 818" aria-hidden="true" focusable="false">
        <path class="mk" pathLength="1" style="--i:0" d="M148 148V848" />
        <path class="mk" pathLength="1" style="--i:1" d="M308 288L686 738" />
        <path class="mk" pathLength="1" style="--i:2" d="M848 148V848" />
      </svg>
      <!-- Wordmark: the vector rebuilt in design/brand/wordmark-green.svg, drawn in the theme's logo colour; the link
           carries the accessible name and phones show the isotype alone. -->
      <svg class="brand-wordmark" viewBox="0 0 423 38" aria-hidden="true" focusable="false">
        <defs><clipPath id="brand-wordmark-clip"><rect x="0" y="2.36" width="423" height="32.97" /></clipPath></defs>
        <g clip-path="url(#brand-wordmark-clip)" fill="currentColor" stroke="none">
          <path d="M3.02 0H7.92V40H3.02ZM33.83 0H38.73V40H33.83ZM181.3 0H186.2V40H181.3ZM212.15 0H217.05V40H212.15ZM142.85 0H147.75V40H142.85ZM320.5 0H325.4V40H320.5ZM320.5 2.36H349.9V5.7H320.5ZM320.5 15.88H345.7V19.37H320.5ZM320.5 31.8H349.9V35.33H320.5ZM249.55 0H254.45V40H249.55Z" />
          <path fill-rule="evenodd" d="M249.55 2.36H268C282.5 2.36 289.85 10 289.85 18.7C289.85 27.4 282.5 35.33 268 35.33H249.55ZM254.45 5.7H267C277 5.7 284.9 11 284.9 18.7C284.9 26.4 277 32 267 32H254.45Z" />
        </g>
        <g clip-path="url(#brand-wordmark-clip)" fill="none" stroke="currentColor" stroke-linejoin="miter" stroke-miterlimit="10">
          <path stroke-width="4.5" d="M5.72 2.36L37.1 35.33M184.0 2.36L215.4 35.33" />
          <path stroke-width="4.6" d="M72.1 35.33L90.53 1.19L108.9 35.33" />
          <path stroke-width="4.6" d="M382.09 1.2L400.36 35.4L418.76 1.2" />
        </g>
      </svg>
    </a>

    <!-- Phone menu toggle (spec 045, VP-009): shown only when the head script ran (html.motion-ready),
         so without JavaScript the links stay visible and the layout never shifts when the script loads. -->
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Menú" data-nav-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
    </button>

    <nav class="primary-navigation" id="primary-navigation" aria-label="Navegación principal">
      <a href="/servicios/" aria-current={current === 'servicios' ? 'page' : undefined}>
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5" /></svg>
        <span>Servicios</span>
      </a>
      <a href="/proyectos/" aria-current={current === 'proyectos' ? 'page' : undefined}>
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4h6v6H4ZM14 4h6v6h-6ZM4 14h6v6H4ZM14 14h6v6h-6Z" /></svg>
        <span>Proyectos</span>
      </a>
      <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6ZM14 3v4h4M9 12h6M9 16h4" /></svg>
        <span>Blog</span>
      </a>
    </nav>

    <div class="header-actions" data-nosnippet>
      <!-- Theme toggle (spec 048): pressed means the paper palette; the choice persists in localStorage. -->
      <button class="theme-toggle" type="button" aria-label="Modo claro" aria-pressed="false" data-theme-toggle>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a class="button button-small button-outline"
        href="https://calendly.com/aitornainmendozavallejo-ksez/30min" target="_blank" rel="noopener noreferrer">Agendar llamada</a>
    </div>
  </div>
</header>
