---
// Footer.astro
---

<footer class="site-footer">
  <div class="shell" style="padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--color-line); display: flex; flex-direction: column; gap: 1rem;">
    <h3 style="font-size: 1.1rem; margin: 0;">Newsletter: Arquitectura y Determinismo 3D</h3>
    <p style="color: var(--color-text-muted); font-size: 0.9rem; margin: 0;">Un email mensual con un concepto arquitectónico destilado para sistemas críticos. Sin spam.</p>
    
    <!-- INICIO MAILERLITE NEWSLETTER EMBED -->
    <div id="mlb2-NEWSLETTER" class="ml-subscribe-form ml-subscribe-form-NEWSLETTER">
      <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/xxx/forms/xxx/subscribe" data-code="xxxx" method="post" target="_blank" data-plausible-form="Newsletter_Subscribe" style="display: flex; gap: 0.5rem; max-width: 400px;">
        <input type="email" name="email" required placeholder="Tu email profesional" style="flex: 1; padding: 0.6rem; border-radius: 6px; border: 1px solid var(--color-line); background: var(--color-surface); color: var(--color-text); font-family: inherit;">
        <button type="submit" class="button button-primary" style="padding: 0.6rem 1rem;">Suscribir</button>
      </form>
    </div>
    <!-- FIN MAILERLITE NEWSLETTER EMBED -->
  </div>

  <div class="shell" style="padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--color-line);">
    <h4 style="font-size: 1rem; margin-bottom: 1rem; color: var(--color-text);">Especialidades Técnicas</h4>
    <div style="display: flex; flex-wrap: wrap; gap: 1.5rem;">
      <a href="/tecnologia/C%23" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">C#</a>
      <a href="/tecnologia/.NET" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">.NET</a>
      <a href="/tecnologia/Three.js" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">Three.js</a>
      <a href="/tecnologia/ONNX" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">ONNX</a>
      <a href="/tecnologia/Azure" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">Azure</a>
      <a href="/tecnologia/Microservicios" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">Microservicios</a>
      <a href="/tecnologia/Arquitectura%20de%20Software" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">Arquitectura</a>
    </div>
  </div>

  <div class="shell footer-layout">
    <p>© <span data-current-year>2026</span> NainDev. Analytics privacy-first integradas (0% cookies). Sin dependencias de terceros que rastreen datos personales.</p>
    <div style="display: flex; gap: 1.5rem; align-items: center;">
      <a href="/recursos/checklist-ia" data-calendly-track="footer" style="color: var(--color-primary-strong); text-decoration: none; font-weight: 500;">📥 Checklist Arquitectura IA</a>
      <a href="/privacidad">Privacidad</a>
      <a href="#top">Volver arriba</a>
    </div>
  </div>
</footer>
