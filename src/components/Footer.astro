---
// Footer.astro
import { getTechnologyHref } from '../utils/technologyRoutes';

const specialtyTechnologies = [
  { name: 'C#', label: 'C#' },
  { name: '.NET', label: '.NET' },
  { name: 'Three.js', label: 'Three.js' },
  { name: 'ONNX', label: 'ONNX' },
  { name: 'Azure', label: 'Azure' },
  { name: 'Microservicios', label: 'Microservicios' },
  { name: 'Arquitectura de Software', label: 'Arquitectura' }
];
---

<footer class="site-footer">
  <div class="shell footer-specialties" data-nosnippet>
    <h2 class="footer-title">Especialidades Técnicas</h2>
    <div class="footer-chips">
      {specialtyTechnologies.map(technology => (
        <a class="footer-chip" href={getTechnologyHref(technology.name)}>{technology.label}</a>
      ))}
    </div>
  </div>

  <div class="shell footer-layout" data-nosnippet>
    <p>© <span data-current-year>2026</span> NainDev. Analytics privacy-first integradas (0% cookies). Sin dependencias de terceros que rastreen datos personales.</p>
    <div class="footer-links">
      <a class="status-pill" href="https://status.naindev.com/" target="_blank" rel="noopener noreferrer" title="Ver monitor público de disponibilidad y latencia">
        <span aria-hidden="true" class="status-dot"></span>
        <span>Estado del servicio</span>
      </a>
      <a class="footer-checklist" href="/recursos/checklist-ia" data-calendly-track="footer">📥 Checklist Arquitectura IA</a>
      <a href="/privacidad">Privacidad</a>
      <a href="#top">Volver arriba</a>
    </div>
  </div>
</footer>
