---
// Footer.astro
import { getTechnologyHref } from '../utils/technologyRoutes';

const specialtyTechnologies = [
  { name: 'C#', label: 'C#' },
  { name: '.NET', label: '.NET' },
  { name: 'Three.js', label: 'Three.js' },
  { name: 'ONNX', label: 'ONNX' },
  { name: 'Azure', label: 'Azure' },
  { name: 'Microservicios', label: 'Microservicios' },
  { name: 'Arquitectura de Software', label: 'Arquitectura' }
];
---

<footer class="site-footer">
  <div class="shell" data-nosnippet style="padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--color-line);">
    <h4 style="font-size: 1rem; margin-bottom: 1rem; color: var(--color-text);">Especialidades Técnicas</h4>
    <div style="display: flex; flex-wrap: wrap; gap: 1.5rem;">
      {specialtyTechnologies.map(technology => (
        <a href={getTechnologyHref(technology.name)} style="color: var(--color-text-muted); text-decoration: none; font-size: 0.9rem;">{technology.label}</a>
      ))}
    </div>
  </div>

  <div class="shell footer-layout" data-nosnippet>
    <p>© <span data-current-year>2026</span> NainDev. Analytics privacy-first integradas (0% cookies). Sin dependencias de terceros que rastreen datos personales.</p>
    <div style="display: flex; gap: 1.5rem; align-items: center;">
      <a href="/recursos/checklist-ia" data-calendly-track="footer" style="color: var(--color-primary-strong); text-decoration: none; font-weight: 500;">📥 Checklist Arquitectura IA</a>
      <a href="/privacidad">Privacidad</a>
      <a href="#top">Volver arriba</a>
    </div>
  </div>
</footer>
