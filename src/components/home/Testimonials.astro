---
// src/components/home/Testimonials.astro
import testimonials from '../../data/testimonials.json';

// Lógica condicional: Solo mostrar si hay más de 0 testimonios reales.
// NOTA: Para no usar fakes, vaciamos el JSON hasta conseguir clientes.
const hasTestimonials = testimonials && testimonials.length > 0 && testimonials[0].name !== "Cliente de Prueba";
---

{hasTestimonials && (
  <section class="section" id="testimonios">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Validación</p>
        <h2>Lo que dicen los Tech Leads</h2>
      </div>
      
      <div class="testimonials-grid" data-reveal>
        {testimonials.map((t) => (
          <div class="testimonial-card">
            <p class="testimonial-content">"{t.content}"</p>
            <div class="testimonial-author">
              <div>
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .testimonial-card {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--color-line);
  }
  .testimonial-content {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .testimonial-author strong {
    display: block;
    color: var(--color-text);
  }
  .testimonial-author span {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
