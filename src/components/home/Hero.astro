---
// Hero.astro
// The receipts band (specs/next-receipts-strip, RC-001) closes the hero with four facts a visitor can check by
// following a link; the publication receipt is the commit being built (RC-002).
import { buildInfo } from '../../utils/build-info';

const build = buildInfo();
const repository = 'https://github.com/Nain9Dev/nain9dev.github.io';
---
<section class="hero section" aria-labelledby="hero-title">
  <canvas id="hero-field" class="hero-field canvas-placeholder" aria-hidden="true"></canvas>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-parallax="true">Aitor Nain Mendoza Vallejo · NainDev</p>
      <h1 id="hero-title" data-parallax="true" data-parallax-speed="0.2">Arquitecto de software full stack: <span class="title-accent">backend fiable e IA verificable.</span></h1>
      <div class="button-group" aria-label="Acciones principales">
        <a class="button button-primary"
          href="https://calendly.com/aitornainmendozavallejo-ksez/30min" target="_blank" rel="noopener noreferrer">Agendar llamada gratuita</a>
        <a class="button button-secondary" href="/servicios/">Ver Servicios</a>
      </div>
      <p class="hero-summary" data-parallax="true" data-parallax-speed="0.1">
        Producto completo en Python y .NET, con IA bajo revisión humana y conformidad determinista de productos, hoy aplicada a modelos 3D en DSE.
      </p>
      <p class="availability">Acepto proyectos a tiempo parcial y en remoto para empresas de cualquier país.</p>
      <p class="hero-stack">Python · C# · FastAPI · .NET · PostgreSQL · SQL Server · Vue 3 · MCP</p>
    </div>
  </div>

  <div class="shell receipts-band">
    <p class="eyebrow receipts-lead" id="receipts-lead">Comprobable</p>
    <ul class="receipts" aria-labelledby="receipts-lead">
      <li>
        <a href={repository} target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Código de este sitio</span>
          <span class="receipt-value" translate="no">Nain9Dev/nain9dev.github.io</span>
        </a>
      </li>
      <li>
        <a href={`${repository}/actions`} target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Comprobaciones en cada cambio</span>
          <span class="receipt-value">Validación, build bilingüe y presupuesto Lighthouse en GitHub Actions</span>
        </a>
      </li>
      <li>
        <a href={`${repository}/commit/${build.sha}`} target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Última publicación</span>
          <span class="receipt-value"><code translate="no">{build.shortSha}</code> · <time datetime={build.date} translate="no">{build.date}</time></span>
        </a>
      </li>
      <li>
        <a href="https://status.naindev.com/" target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Estado de los servicios</span>
          <span class="receipt-value">Monitor público de disponibilidad y latencia</span>
        </a>
      </li>
    </ul>
  </div>
</section>
