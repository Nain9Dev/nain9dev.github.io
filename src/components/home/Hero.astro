---
// Hero.astro
// The receipts band (specs/next-receipts-strip, RC-001) closes the hero with four facts a visitor can check by
// following a link; the publication receipt is the commit being built (RC-002).
import { buildInfo } from '../../utils/build-info';

const build = buildInfo();
const repository = 'https://github.com/Nain9Dev/nain9dev.github.io';
---
<section class="hero section" aria-labelledby="hero-title">
  <canvas id="hero-field" class="hero-field canvas-placeholder" aria-hidden="true"></canvas>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-parallax="true">Aitor Nain Mendoza Vallejo · NainDev</p>
      <h1 id="hero-title" data-parallax="true" data-parallax-speed="0.2">Arquitecto de software full stack: <span class="title-accent">backend fiable e IA verificable.</span></h1>
      <nav class="offer-row" aria-label="Qué ofrezco">
        <a class="offer-tile" href="/servicios/sistemas-criticos-dotnet">
          <svg class="offer-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><ellipse cx="24" cy="11" rx="14" ry="5" /><path d="M10 11v13c0 2.8 6.3 5 14 5s14-2.2 14-5V11M10 24v13c0 2.8 6.3 5 14 5s14-2.2 14-5V24" /></svg>
          <strong>Backend crítico</strong>
          <span>Python y .NET con datos consistentes</span>
        </a>
        <a class="offer-tile" href="/servicios/arquitectura-ia-generativa">
          <svg class="offer-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect x="9" y="14" width="30" height="22" rx="6" /><path d="M24 14V8M19 25v2M29 25v2M4 25v4M44 25v4" /><circle cx="24" cy="6" r="2" /></svg>
          <strong>IA con revisión humana</strong>
          <span>Agentes y flujos verificables</span>
        </a>
        <a class="offer-tile" href="/servicios/validacion-3d">
          <svg class="offer-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 5 8 14v20l16 9 16-9V14L24 5ZM24 24 8 14M24 24l16-10M24 24v19" /></svg>
          <strong>Validación 3D</strong>
          <span>Veredictos reproducibles</span>
        </a>
      </nav>
      <div class="button-group" aria-label="Acciones principales">
        <a class="button button-primary"
          href="https://calendly.com/aitornainmendozavallejo-ksez/30min" target="_blank" rel="noopener noreferrer">Agendar llamada gratuita</a>
        <a class="button button-secondary" href="/servicios/">Ver Servicios</a>
      </div>
      <p class="hero-summary" data-parallax="true" data-parallax-speed="0.1">
        Producto completo en Python y .NET, con IA bajo revisión humana. Conformidad determinista: su primer dominio son los modelos 3D.
      </p>
      <p class="availability">Acepto proyectos a tiempo parcial y en remoto para empresas de cualquier país.</p>
      <a class="scroll-cue" href="#services">
        <span>Explorar el portfolio</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <aside class="hero-panel" aria-label="Mapa de capacidades técnicas">
      <div class="panel-heading">
        <p class="panel-label">Cómo conecto el backend</p>
        <span class="panel-state">Tiempo parcial</span>
      </div>
      <div class="system-map">
        <a class="system-node system-node-api" href="#services">
          <span>01</span>
          <strong>API</strong>
          <small>Contratos y validación</small>
        </a>
        <a class="system-node system-node-domain" href="#method">
          <span>02</span>
          <strong>Lógica</strong>
          <small>Reglas y casos de uso</small>
        </a>
        <a class="system-node system-node-data" href="#projects">
          <span>03</span>
          <strong>Datos</strong>
          <small>PostgreSQL, SQL Server y consistencia</small>
        </a>
      </div>
      <p class="panel-stack">Python · C# · FastAPI · .NET · PostgreSQL · SQL Server · Vue 3 · MCP</p>
      <p class="panel-hint">Cada bloque te lleva a una evidencia relacionada.</p>
    </aside>
  </div>

  <div class="shell receipts-band">
    <p class="eyebrow receipts-lead" id="receipts-lead">Comprobable</p>
    <ul class="receipts" aria-labelledby="receipts-lead">
      <li>
        <a href={repository} target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Código de este sitio</span>
          <span class="receipt-value" translate="no">Nain9Dev/nain9dev.github.io</span>
        </a>
      </li>
      <li>
        <a href={`${repository}/actions`} target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Comprobaciones en cada cambio</span>
          <span class="receipt-value">Validación, build bilingüe y presupuesto Lighthouse en GitHub Actions</span>
        </a>
      </li>
      <li>
        <a href={`${repository}/commit/${build.sha}`} target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Última publicación</span>
          <span class="receipt-value"><code translate="no">{build.shortSha}</code> · <time datetime={build.date} translate="no">{build.date}</time></span>
        </a>
      </li>
      <li>
        <a href="https://status.naindev.com/" target="_blank" rel="noopener noreferrer">
          <span class="receipt-label">Estado de los servicios</span>
          <span class="receipt-value">Monitor público de disponibilidad y latencia</span>
        </a>
      </li>
    </ul>
  </div>
</section>
