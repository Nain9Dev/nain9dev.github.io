---
// LiveDemos.astro: static gallery of the public demos hosted on naindev.com subdomains (spec next-portfolio-refresh, spec 046).
// Each tile shows the demo's capture; host and technologies stay in the markup, visually hidden.
// Tiles load the 400 px variant and the 640 px one only where the rendered size asks for it (spec 032 transfer budget).
import projects from '../../../public/assets/data/projects.json';

const isOwnDemo = (url: string) => /^https:\/\/[a-z0-9-]+\.naindev\.com(?:\/|$)/.test(url);
const demos = [...projects]
  .sort((a, b) => a.order - b.order)
  .flatMap((project) => {
    const link = project.links.find((entry) => isOwnDemo(entry.url));
    const thumbnail = project.thumbnail ?? null;
    return link ? [{ title: project.title, url: link.url, host: new URL(link.url).hostname, tech: project.technologies.slice(0, 2).join(' · '), thumbnail, small: thumbnail?.replace(/\.webp$/, '-400.webp') ?? null }] : [];
  });
---
<section class="live-demos" aria-labelledby="live-demos-title">
  <div class="shell">
    <h2 id="live-demos-title" class="live-demos-title"><span class="live-dot" aria-hidden="true"></span>Demos en vivo</h2>
    <ul class="live-demos-grid">
      {demos.map((demo) => (
        <li>
          <a class="live-demo" href={demo.url} target="_blank" rel="noopener noreferrer">
            {demo.thumbnail && <img class="live-demo-thumb" src={demo.small} srcset={`${demo.small} 400w, ${demo.thumbnail} 640w`} sizes="(max-width: 42rem) 54vw, 12rem" alt="" width="400" height="225" loading="lazy" decoding="async" />}
            <strong>{demo.title}</strong>
            <span class="live-demo-host" translate="no">{demo.host}</span>
            <span class="live-demo-tech" translate="no">{demo.tech}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
