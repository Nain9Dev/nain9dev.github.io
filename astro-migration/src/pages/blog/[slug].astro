---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Aitor Nain`} description={post.data.excerpt} image={post.data.coverImage} date={post.data.date} tags={post.data.tags}>
  <style is:inline>
    .blog-post { max-width: 800px; margin: 0 auto; padding-bottom: 4rem; }
    .blog-post h1 { font-size: 2.8rem; margin-bottom: 1rem; line-height: 1.2; letter-spacing: -0.02em; }
    .blog-post .meta { color: var(--color-text-muted); margin-bottom: 3.5rem; font-size: 0.95rem; display: flex; gap: 1rem; align-items: center; }
    .blog-post .meta-tag { background: var(--color-surface); padding: 0.25rem 0.75rem; border-radius: 100px; font-weight: 500; font-size: 0.85rem; border: 1px solid var(--color-line); }
    .blog-post h2 { margin-top: 3.5rem; margin-bottom: 1.5rem; font-size: 2rem; border-bottom: 1px solid var(--color-line); padding-bottom: 0.75rem; }
    .blog-post h3 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.4rem; color: var(--color-heading); }
    .blog-post p { margin-bottom: 1.75rem; font-size: 1.15rem; line-height: 1.8; color: var(--color-text); }
    .blog-post ul, .blog-post ol { margin-bottom: 1.75rem; padding-left: 1.5rem; font-size: 1.15rem; line-height: 1.8; }
    .blog-post li { margin-bottom: 0.75rem; }
    .blog-post pre { background: #111111; color: #f8f8f2; padding: 1.5rem; border-radius: 8px; overflow-x: auto; margin-top: 2rem; margin-bottom: 2rem; border: 1px solid #333; }
    .blog-post code { font-family: 'Consolas', 'Monaco', monospace; font-size: 0.95rem; }
    .blog-post p code, .blog-post li code { background: var(--color-surface); padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.95rem; color: var(--color-primary); border: 1px solid var(--color-line); }
    .blog-post strong { font-weight: 600; color: var(--color-heading); }
    .blog-post blockquote { border-left: 4px solid var(--color-primary); padding-left: 1.5rem; margin: 2rem 0; font-style: italic; color: var(--color-text-muted); font-size: 1.25rem; line-height: 1.6; }
    
    .blog-cta { margin-top: 5rem; padding: 3rem; background: var(--color-surface); border-radius: 12px; text-align: center; border: 1px solid var(--color-primary); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .blog-cta h3 { margin-top: 0; margin-bottom: 1rem; font-size: 1.8rem; }
    .blog-cta p { margin-bottom: 2rem; font-size: 1.1rem; max-width: 600px; margin-left: auto; margin-right: auto; }
    .lead-magnet-form { display: flex; flex-direction: column; gap: 1rem; max-width: 400px; margin: 0 auto; }
    @media (min-width: 600px) { .lead-magnet-form { flex-direction: row; max-width: 550px; } }
    .lead-magnet-input { flex: 1; padding: 0.8rem 1.2rem; border-radius: 8px; border: 1px solid var(--color-line); background: var(--color-background); color: var(--color-text); font-size: 1rem; }
    .lead-magnet-input:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 2px rgba(var(--color-primary-rgb), 0.2); }
    .lead-magnet-disclaimer { margin-top: 1rem !important; font-size: 0.85rem !important; color: var(--color-text-muted) !important; margin-bottom: 0 !important; }
  </style>

  <main id="main-content" class="shell" style="margin-top: 8rem; min-height: 70vh;">
    <article class="blog-post">
      <h1>{post.data.title}</h1>
      
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <span>·</span>
        <span>Aitor Nain</span>
        <span>·</span>
        {post.data.tags.map(tag => (
          <span class="meta-tag">{tag}</span>
        ))}
      </div>

      <Content />
    </article>
  </main>
</BaseLayout>
