---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Sistema de Validación y Corrección 3D (IA) — Casos de Estudio | Aitor Nain";
const description = "Caso de Estudio: Diseño de una arquitectura backend determinista para la validación de activos 3D generados por IA a escala industrial.";
---

<BaseLayout title={title} description={description}>
  <main id="main-content">
    <section class="section" id="case-study-detail">
      <div class="shell">
        <nav aria-label="Breadcrumb" class="breadcrumbs" style="margin-bottom: 2rem; font-size: 0.9rem; color: var(--color-text-muted);">
          <ol style="list-style: none; padding: 0; display: flex; gap: 0.5rem;">
            <li><a href="/" style="color: var(--color-primary-strong); text-decoration: none;">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/#case-studies" style="color: var(--color-primary-strong); text-decoration: none;">Casos de Estudio</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Validación y Corrección 3D (IA)</li>
          </ol>
        </nav>

        <article class="case-study-card" style="box-shadow: none; border: none; background: transparent; padding: 0;">
          <div class="case-study-header">
            <p class="case-study-eyebrow">Proyecto Confidencial (Industria 3D) · Colaborador Técnico</p>
            <h1 class="case-study-title" style="font-size: 2.5rem; margin-bottom: 1.5rem;">Sistema de Validación y Corrección 3D (IA)</h1>
          </div>
          <div class="case-study-body">
            <div class="case-study-section">
              <h2>El Problema</h2>
              <p>La IA generativa produce modelos 3D con inconsistencias estructurales inutilizables en industrias especializadas sin horas de corrección manual.</p>
            </div>
            <div class="case-study-section">
              <h2>Decisiones Arquitectónicas</h2>
              <ul class="case-study-list decisions-list">
                <li>Diseño de un sistema de validación agnóstico al modelo fundacional de IA generativa.</li>
                <li>Desarrollo de un ecosistema de agentes e integraciones seguras bajo estrictos NDAs.</li>
                <li>Arquitectura distribuida orientada a procesamiento masivo en tiempo real.</li>
              </ul>
            </div>
            <div class="case-study-diagram">
              <div class="mermaid">
                graph TD
                A[AI Generator] --> B[Arquitectura de Validación]
                B --> C[Geometric Validation API]
                C --> D[Topology Correction Engine]
                D --> E[Industry-Ready 3D Asset]
              </div>
            </div>
            <div class="case-study-section">
              <h2>Trade-offs</h2>
              <p class="case-study-tradeoff">Optamos por un modelo híbrido para maximizar la adopción sin comprometer la seguridad ni la propiedad intelectual del motor propietario de correcciones.</p>
            </div>
            <div class="case-study-section results-section">
              <h2>Resultados</h2>
              <ul class="case-study-list results-list">
                <li>Validación automatizada de alto volumen en tiempos de procesamiento mínimos.</li>
                <li>Ecosistema adoptado como estándar transversal para agentes de IA 3D internos.</li>
                <li>Precisión determinista lista para integraciones industriales complejas.</li>
              </ul>
            </div>
            <div class="case-study-section tech-section">
              <div class="tech-badge-container" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;">
                <span class="tech-badge-small">Backend Architecture</span><span class="tech-badge-small">AI Integration</span><span class="tech-badge-small">3D Validation</span><span class="tech-badge-small">Clean Architecture</span>
              </div>
            </div>
          </div>
        </article>

        <div style="margin-top: 4rem; text-align: center;">
          <a class="button button-secondary" href="/#case-studies">Volver a Casos de Estudio</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
