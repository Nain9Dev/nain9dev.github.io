---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  date?: Date;
  author?: string;
  tags?: string[];
}

const {
  title = "Aitor Nain — Arquitecto Backend 3D & AI Systems | .NET",
  description = "Arquitecto Backend especializado en infraestructura para procesamiento 3D masivo, integración de IA Generativa, agentes de IA y sistemas críticos .NET.",
  image = "https://www.naindev.com/assets/images/og-cover-v2.png",
  date,
  author,
  tags
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.naindev.com');
---

<!doctype html>
<html lang="es">
<head>
  <SEO title={title} description={description} image={image} canonicalURL={canonicalURL} date={date} author={author} tags={tags} />
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon-optimized.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon-optimized.svg">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="stylesheet" href="/assets/css/terminal.css">
  <script defer data-domain="naindev.com" src="https://plausible.io/js/script.js"></script>
  <script is:inline>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
  <title>{title}</title>

  <slot name="head" />
</head>

<body id="top">
  <a class="skip-link" href="#main-content">Saltar al contenido principal</a>

  <Header />

  <slot />

  <Footer />

  <script>
    import "../../public/assets/js/app.js";
  </script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('a[href^="mailto:"]').forEach(link => {
        link.addEventListener('click', () => window.plausible && window.plausible('Contacto', {props: { method: 'Email' }}));
      });
      // 1. Tracking de Intención: Clics en Calendly
      document.querySelectorAll('a[href*="calendly.com"]').forEach(link => {
        link.addEventListener('click', () => {
          if (window.plausible) {
            const sourceSection = link.closest('section')?.id || 'header';
            window.plausible('Agendar Llamada', { props: { source: sourceSection } });
          }
        });
      });

      // 2. Tracking de Engagement: Comandos en la Terminal
      const terminalInput = document.getElementById('terminal-input');
      if (terminalInput) {
        terminalInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && terminalInput.value.trim() !== '') {
            const command = terminalInput.value.trim().split(' ')[0].toLowerCase();
            if (window.plausible) {
              window.plausible('Terminal Command', { props: { command: command } });
            }
          }
        });
      }
      document.querySelectorAll('a[href^="http"]').forEach(link => {
        if (!link.href.includes('naindev.com') && !link.href.includes('calendly.com')) {
          link.addEventListener('click', () => window.plausible && window.plausible('Outbound Link', {props: { url: link.href }}));
        }
      });
    });
  </script>
</body>
</html>
